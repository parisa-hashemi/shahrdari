# API mode: "mock" uses the in-browser deterministic mock backend,
# "real" routes every call through the HTTP client to VITE_API_BASE_URL.
VITE_API_MODE=mock

# Base URL of the FastAPI backend described in the FSD (used when VITE_API_MODE=real)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Simulated network latency for the mock API, in milliseconds
VITE_MOCK_LATENCY_MS=280

# Demo banner ("داده نمایشی") shown across the app. Set to "false" for a real deployment.
VITE_DEMO_MODE=true

# Default UI locale / direction (architecture supports en/ltr in the future)
VITE_DEFAULT_LOCALE=fa
